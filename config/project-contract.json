  "project_center": {
    "content_contract": "config/project-center-content.json",
    "api_prefix": "/api/project-center",
    "api": {
      "overview": {"method": "GET", "path": "/overview", "returns": ["project", "runtime", "daily", "source", "observed_at", "content_version", "stale"]},
      "modules": {"method": "GET", "path": "/modules", "detail_path": "/modules/{module_id}", "returns": ["entry", "runtime", "known_gap", "impact"]},
      "change_basket": {"paths": ["GET /change-basket", "POST /change-basket", "PATCH /change-basket/{item_id}"], "record": ["id", "created_at", "updated_at", "owner", "module_id", "module_name", "optional_note", "status", "context_snapshot", "revision", "archived_at"]},
      "requests": {"paths": ["GET /requests", "POST /requests", "GET /requests/{request_id}", "PATCH /requests/{request_id}"], "record": ["id", "basket_item_ids", "user_problem", "desired_experience", "desired_result", "status", "verification_summary", "revision"]},
      "deliveries": {"paths": ["GET /deliveries", "POST /deliveries", "GET /deliveries/{delivery_id}", "PATCH /deliveries/{delivery_id}"], "record": ["id", "request_id", "title", "status", "user_visible_change", "verification_evidence", "user_validation_path", "revision"]}
    },
    "data_domain": "project_center",
    "data_store": "data/project_center.sqlite3",
    "result_statuses": ["ok", "partial", "empty", "conflict", "unavailable", "error"],
    "module_runtime_statuses": ["healthy", "degraded", "paused", "disabled", "broken"],
    "lifecycle_statuses": ["Planned", "In Progress", "Implemented", "Verified", "Released", "Blocked", "Abandoned"],
    "write_contract": {
      "requires": ["owner", "revision", "input_cleaning", "idempotency_key", "readback"],
      "soft_archive": true,
      "verified_requires_evidence": ["observed_at", "environment", "entry", "result", "risk"],
      "forbidden_business_writes": ["TK", "比赛", "交易记录", "项目模块合同"]
    },
    "agent_read_entry": "xiaoxue_get_change_basket"
  },
  "path_templates": {
    "current_event_plan": "/home/ubuntu/workspace/knowledge/wiki/{knowledge_namespace}/20_游戏理解/当前赛事/当前交易预案.md"
  },
  "rules_source": "AGENTS.md",
  "rule_sections": {
    "position": "AGENTS.md#项目定位与产物",
    "boundaries": "AGENTS.md#业务边界",
    "change_and_verification": "AGENTS.md#变更与验证"
  }
