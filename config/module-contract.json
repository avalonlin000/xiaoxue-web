  "result_contract": {
    "statuses": ["ok", "partial", "empty", "conflict", "unavailable", "error"],
    "success": "summary/data/sources/effects 可供审计和业务组织使用。",
    "empty": "明确返回没有数据或资料缺口，不伪造相邻对象或旧结果。",
    "conflict": "并列返回来源、时间、冲突点和影响，不静默折中。",
    "error": "稳定错误和可继续部分可观察，不把失败转成换口令。",
    "write": "写入指定正源并记录副作用；未确认成功不得报成功。",
    "readback": "写入、修正或配置变化后从正式正源重新读取，保存类结果必须带 readback。"
  },
  "modules": [
    {
      "id": "ts_strength",
      "display_name": "TS／队伍实力展示",
      "purpose": "查看同赛区队伍的处理后实力、稳定性、趋势、势头和状态，作为后续比较与分析的事实输入。",
      "ownership": "电竞事实与分析",
      "user_entry": {
        "natural_examples": ["查 LPL 的 TS", "比较 HLE 和 GEN 的实力"],
        "web": "队伍资料页的 TS 表"
      },
      "agent_entry": {
        "skill": "xiaoxue",
        "tools": ["xiaoxue_get_team", "xiaoxue_get_ts_updates"],
        "behavior": "先按当前问题读取需要的队伍或比较结果；不要求固定顺序，不把原始模型量当用户结果。"
      },
      "source_of_truth": {
        "label": "活动阶段 TS 快照与展示层（国内/国际）",
        "api": "/api/fundamentals/teams",
        "display_path": "ts_display"
      },
      "read_capability": {
        "id": "fundamentals.read",
        "entry": "/api/fundamentals/teams",
        "empty": "没有当前阶段展示值时明确资料不足，不用旧种子值冒充当前阶段。"
      },
      "bounded_write_capability": {
        "id": "data_refresh",
        "entry": "/api/data-refresh",
        "scope": "后台刷新赛果和 TS；不是普通对话里的临时改值。"
      },
      "readback_capability": {
        "entry": "/api/fundamentals/teams?team={team}",
        "checks": ["team", "ts_display", "source"]
      },
      "analysis_capability": {
        "id": "fundamentals.match_context",
        "entry": "/api/fundamentals/match-context",
        "boundary": "只提供基本面事实和差异，不替小雪作交易决定。"
      },
      "field_mapping": {
        "display": {
          "power_score": "综合实力",
          "volatility_score": "稳定性",
          "trend": "趋势",
          "momentum": "势头",
          "status": "状态"
        },
        "legacy_aliases": {
          "strength_score": "power_score",
          "stability_score": "volatility_score",
          "conclusion_score": "status"
        },
        "consumer_contract": "API、前端 TS 表、日报和阵容/交易分析只消费上述展示字段。"
      },
      "extension_kind": "ordinary_content",
      "consumers": ["队伍资料页", "日报", "阵容分析", "交易判断"],
      "status": "available",
      "compatibility": {
        "backend_capabilities": ["fundamentals"],
        "frontend_loaders": ["teams"],
        "legacy_names": ["队伍基本面", "TS 表", "三维 TS"]
      }
    },
