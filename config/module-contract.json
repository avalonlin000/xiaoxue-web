  "tool_contract": {
    "mcp": "xiaoxue-product",
    "read_schema": "命名读取能力只读正源并返回精简业务字段；不让模型用终端摸库或猜入口。",
    "write_schema": "命名写入能力只接收明确对象、身份和范围；普通小范围更新可自治，结构级动作返回干预。",
    "structured_output": false,
    "model_max_chars": 3000
